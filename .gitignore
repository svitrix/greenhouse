.pio/
.vscode/
.idea/
.DS_Store

# Claude Code — local machine-specific permissions (absolute paths, session history)
.claude/settings.local.json
**/include/secrets.h
platformio_local.ini

# ESPHome secrets — real Wi-Fi/API passwords. Only secrets.yaml.example is tracked.
**/secrets.yaml
!**/secrets.yaml.example

# Zigbee Trust Center link key — real bytes never committed. Only the
# template (secrets.hpp.example) is tracked.
firmware/shared/protocol/src/secrets.hpp
!firmware/shared/protocol/src/secrets.hpp.example

# HW-test credentials (real Wi-Fi + MQTT broker). Only .example is tracked.
firmware/coordinator/test/test_drivers/test_mqtt_client/test_creds.hpp
!firmware/coordinator/test/test_drivers/test_mqtt_client/test_creds.hpp.example

# EspHttpsClient hwtest secrets (Wi-Fi + backend URL/key). Only .example tracked.
firmware/coordinator/test/test_drivers/test_esp_https_client/secrets.hpp
!firmware/coordinator/test/test_drivers/test_esp_https_client/secrets.hpp.example

# LittleFS image source — generated by scripts/build-data.sh from web/dist
firmware/coordinator/data/*
!firmware/coordinator/data/.gitkeep

# Dashboard / frontend (D-3a)
services/dashboard/node_modules/
services/dashboard/dist/
services/dashboard/.env
services/dashboard/.env.local
services/dashboard/coverage/
# Generated build outputs (sources are vite.config.ts / tsconfig*.json)
services/dashboard/*.tsbuildinfo
services/dashboard/vite.config.js
services/dashboard/vite.config.d.ts

# CodeGraph index — local to each machine
.codegraph/
