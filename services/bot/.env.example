# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Comma-separated allowlist of Telegram user ids permitted to drive the bot.
# Empty = the bot denies everyone (fail-closed). Find your id via @userinfobot.
TELEGRAM_ALLOWED_USER_IDS=

# Hub REST API base URL and an admin bearer token. Mint the token with:
#   docker compose exec hub python -m app.tools.mint_admin_token --name telegram-bot
HUB_API_URL=http://localhost:8000
HUB_ADMIN_TOKEN=

# How often (seconds) the bot polls the hub for new watering events.
BOT_POLL_SECONDS=30

# Where python-telegram-bot persists subscribers + the event cursor.
PERSISTENCE_PATH=/data/bot_persistence.pkl

LOG_LEVEL=INFO
