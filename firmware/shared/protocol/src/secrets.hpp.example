#pragma once
#include <cstdint>

// Trust Center pre-configured link key.
//
// REPLACE the bytes below with a random 16-byte value before flashing real
// hardware. Generate with: openssl rand -hex 16
//
// This file is a template tracked in git. The real key lives in
// secrets.hpp (same directory) and is git-ignored. Copy this file to
// secrets.hpp on first checkout and substitute your own bytes.
//
// Both coordinator and sensor-node must compile against the SAME bytes
// or pairing will fail. Changing the key after pairing requires a NVS
// erase on both devices.

namespace gh::protocol {

constexpr uint8_t kZigbeeTcLinkKey[16] = {
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
};

}
